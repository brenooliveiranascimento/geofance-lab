# =============================================================================
# Geofence Lab — variáveis de ambiente
# cp .env.example .env    (o .env nunca é commitado)
# =============================================================================

# -----------------------------------------------------------------------------
# GOOGLE MAPS (Android)
# Obrigatória só para o mapa no Android — o react-native-maps renderiza pelo SDK
# do Google Maps. Sem ela o app continua funcionando: o MonitorScreen cai no modo
# lista. No iOS o MapKit é usado e nenhuma chave é necessária.
#
# console.cloud.google.com → APIs e serviços → Credenciais → Criar chave de API
# Habilite a "Maps SDK for Android" no projeto. O carregamento de mapa em apps
# móveis não é cobrado, mas o projeto precisa de faturamento ativo para emitir
# a chave.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# ENDPOINT DE CONFIRMAÇÃO DE ENTREGA
# Para onde o módulo de mensagens envia a confirmação de entrega de cada
# notificação (POST JSON). Deixe vazio para desligar o envio — a fila continua
# sendo gravada localmente e pode ser inspecionada na aba Mensagens.
# Para testar, gere uma URL descartável em https://webhook.site
# -----------------------------------------------------------------------------
EXPO_PUBLIC_DELIVERY_ENDPOINT=
